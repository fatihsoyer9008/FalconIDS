# FalconIDS Ortam Degiskenleri
# Bu dosyayi .env olarak kopyalayin ve degerleri doldurun:
#   cp .env.example .env
#   source .env
#
# NOT: .env dosyasini Git'e COMMITLEMEMEK icin .gitignore'a eklenmelidir.

# ─── Ozellik 1: Threat Intelligence (AbuseIPDB) ──────────────────────────────
# Ucretsiz API anahtari almak icin: https://www.abuseipdb.com/register
# Bos birakirsaniz tehdit istihbarati modulu devre disi olur.
ABUSEIPDB_API_KEY="buraya_api_anahtarinizi_yazin"

# ─── Ozellik 2: Gercek Zamanli Bildirimler ───────────────────────────────────
# Discord ve/veya Telegram yapilandirilabilir. Ikisi de ayni anda aktif olabilir.
# Hicbiri ayarlanmazsa bildirim modulu devre disi olur.

# Discord Webhook URL'si
# Webhook olusturma: Sunucu Ayarlari > Entegrasyonlar > Web Hooklari > Yeni Webhook
DISCORD_WEBHOOK_URL=""

# Telegram Bot Token ve Chat ID
# Bot olusturma: Telegram'da @BotFather > /newbot komutu
# Chat ID bulma: Bot'a bir mesaj gonderip https://api.telegram.org/bot<TOKEN>/getUpdates adresini acin
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ─── Ozellik 3: Otomatik Engelleme / IPS ─────────────────────────────────────
# DIKKAT: Bu ozellik aktiflestirildiginde, tespit edilen saldirgan IP'ler
# iptables veya ufw uzerinden otomatik olarak engellenir!
# Root yetkisi gerektirir (FalconIDS zaten root ile calisir).

# IPS modulunu aktiflestirir (1 = aktif, bos/0 = devre disi)
FALCON_IPS_ENABLED=0

# Bir IP'nin engellenmesi icin gereken minimum alert sayisi (varsayilan: 3)
# AbuseIPDB skoru >= 80 olan IP'ler bu esigi beklemeden aninda engellenir.
FALCON_BLOCK_THRESHOLD=3

# Asla engellenmemesi gereken IP'ler (virgul ile ayrilmis)
# Ornek: gateway, DNS sunuculari, izleme sistemleri, vb.
FALCON_WHITELIST="8.8.8.8,8.8.4.4,1.1.1.1"
